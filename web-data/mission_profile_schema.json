{
  "name": "Lunar Site Scout - Mission Profile v1",
  "rule": "Each field is {\"v\": value, \"l\": label, \"src\": source}. Labels: declared | derived | asked | estimated (last resort). A missing value is never guessed: the engine bounds it (range) or returns a requirement. Fields with a 'convention' are filled with that engineering convention and listed in the report under 'assumptions'.",
  "fields": [
    {"block": "mission", "key": "type", "unit": "robotic_lander | crewed | long_duration_lander | rover | infrastructure", "core": true, "used_for": "verdict weights and checks"},
    {"block": "mission", "key": "duration_days", "unit": "Earth days", "core": true, "used_for": "simulation window", "if_missing": "14 days (one lunar day) - convention"},
    {"block": "mission", "key": "continuous_sun_required", "unit": "bool", "core": false, "used_for": "crewed missions: no dark period allowed"},
    {"block": "mission", "key": "must_survive_night", "unit": "bool", "core": false, "used_for": "power/thermal checks across dark periods"},
    {"block": "mission", "key": "max_distance_to_psr_km", "unit": "km", "core": false, "used_for": "distance to permanently shadowed regions (NASA PSR catalogue)"},
    {"block": "timing", "key": "earliest_landing_utc", "unit": "ISO date-time", "core": true, "used_for": "start of the landing-window scan"},
    {"block": "timing", "key": "max_slip_days", "unit": "days", "core": true, "used_for": "length of the scan (what if we slip)", "if_missing": "30 days - convention"},
    {"block": "landing", "key": "ellipse_radius_m", "unit": "m", "core": true, "used_for": "worst/median/best point of the ellipse on 5 m terrain"},
    {"block": "landing", "key": "max_slope_deg", "unit": "deg", "core": true, "used_for": "share of the ellipse safe to land"},
    {"block": "landing", "key": "min_sun_elevation_deg", "unit": "deg", "core": false, "used_for": "optical navigation at landing"},
    {"block": "landing", "key": "earth_visible_at_landing", "unit": "bool", "core": false, "used_for": "telemetry during descent"},
    {"block": "landing", "key": "max_rock_size_m", "unit": "m", "core": false, "used_for": "not evaluated in the prototype (needs 1 m hazard maps)"},
    {"block": "power", "key": "panels", "unit": "list of {peak_w, tilt_deg (90 vertical, 0 flat), azimuth_deg relative to lander, tracking}", "core": true, "used_for": "power produced at every half hour"},
    {"block": "power", "key": "lander_yaw_deg", "unit": "deg", "core": false, "used_for": "panel orientation on the ground", "if_missing": "8 orientations tested -> range"},
    {"block": "power", "key": "panel_height_m", "unit": "m", "core": false, "used_for": "horizon at 2 / 10 / 20 m", "if_missing": "2 m - convention"},
    {"block": "power", "key": "battery_wh", "unit": "Wh", "core": true, "used_for": "battery simulation", "if_missing": "requirement: battery needed"},
    {"block": "power", "key": "battery_dod", "unit": "0-1", "core": false, "used_for": "usable battery", "if_missing": "0.8 - convention"},
    {"block": "power", "key": "charge_efficiency", "unit": "0-1", "core": false, "used_for": "energy stored", "if_missing": "0.95 - convention"},
    {"block": "power", "key": "load_operations_w", "unit": "W", "core": true, "used_for": "energy balance", "if_missing": "requirement: max sustainable load"},
    {"block": "power", "key": "load_survival_w", "unit": "W", "core": false, "used_for": "survival mode (heaters) when battery is low"},
    {"block": "power", "key": "peak_loads", "unit": "list of {w, hours, needs: sun|earth|any}", "core": false, "used_for": "activity timeline (next version)"},
    {"block": "comms", "key": "mode", "unit": "DTE | relay", "core": true, "used_for": "whether Earth visibility is required"},
    {"block": "comms", "key": "ground_stations", "unit": "DSN | none", "core": false, "used_for": "contact only when a station sees the Moon", "if_missing": "DSN - convention"},
    {"block": "comms", "key": "antenna_height_m", "unit": "m", "core": false, "used_for": "horizon for the Earth", "if_missing": "same as panel height"},
    {"block": "comms", "key": "min_earth_elevation_deg", "unit": "deg above terrain", "core": false, "used_for": "link margin over the horizon", "if_missing": "0 deg - convention"},
    {"block": "comms", "key": "min_pass_hours", "unit": "h", "core": false, "used_for": "ignore contacts too short to be useful", "if_missing": "0 h"},
    {"block": "comms", "key": "data_rate_kbps", "unit": "kbps", "core": false, "used_for": "data that can be sent", "if_missing": "requirement: rate needed"},
    {"block": "comms", "key": "data_volume_mb", "unit": "MB", "core": false, "used_for": "data that must be sent"},
    {"block": "thermal", "key": "max_dark_hours", "unit": "h", "core": false, "used_for": "proxy for cold survival (full thermal model not evaluated)"},
    {"block": "mobility", "key": "rover_range_km", "unit": "km", "core": false, "used_for": "shadowed regions within reach"},
    {"block": "site", "key": "candidate_sites", "unit": "list of site ids or lat/lon", "core": false, "used_for": "sites to scan", "if_missing": "all 11 characterised sites"},
    {"block": "site", "key": "min_distance_other_assets_m", "unit": "m", "core": false, "used_for": "not evaluated in the prototype"}
  ]
}
